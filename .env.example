# Nome do repositório no Prismic (ex.: "ecvilaferreira").
# Sem esta variável o site é gerado com o conteúdo de exemplo de src/data/fallback.ts.
PRISMIC_REPOSITORY=

# Token de acesso, apenas se a API do repositório Prismic for privada.
PRISMIC_ACCESS_TOKEN=

# URL pública do site (usada em canonical, Open Graph e sitemap).
# Opcional na Vercel: sem ela, o build usa o domínio de produção do projeto.
SITE_URL=https://ecvilaferreira.vercel.app
