---
import Ilustracao from '@/components/ui/Ilustracao.astro';
import Midia from '@/components/ui/Midia.astro';
import { formatarData } from '@/lib/format';
import type { Noticia } from '@/lib/types';

/**
 * Notícias da página inicial em formato de jornal: a mais recente ocupa a manchete,
 * as seguintes viram uma coluna com a data em destaque. Com poucas notícias, a coluna
 * se completa com um convite para acompanhar o clube nas redes.
 */
interface Props {
  noticias: Noticia[];
  instagram?: string;
}
const { noticias, instagram } = Astro.props;
const [manchete, ...demais] = noticias.slice(0, 4);

const dia = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', timeZone: 'UTC' });
const mes = new Intl.DateTimeFormat('pt-BR', { month: 'short', timeZone: 'UTC' });
const partesData = (iso: string) => {
  const data = new Date(`${iso.slice(0, 10)}T00:00:00Z`);
  return { dia: dia.format(data), mes: mes.format(data).replace('.', '') };
};
const convite = demais.length < 3;
---

<section class="noticias" id="noticias" aria-labelledby="noticias-titulo">
  <div class="container">
    <header class="noticias__cabecalho">
      <div>
        <p class="noticias__chapeu" data-revelar>Clube</p>
        <h2 id="noticias-titulo" data-dividir>Últimas notícias</h2>
      </div>
      <a class="ver-mais" href="/noticias" data-revelar>Todas as notícias</a>
    </header>

    <div class="noticias__grade">
      <div data-revelar>
      <article class="manchete card" data-inclinar="3" data-cursor="Ler">
        <div class="manchete__midia">
          <Midia imagem={manchete.imagem} proporcao={16 / 10} sizes="(min-width: 60rem) 40rem, 100vw" />
          <span class="manchete__categoria">{manchete.categoria}</span>
        </div>
        <div class="manchete__corpo">
          <time class="manchete__data" datetime={manchete.data}>{formatarData(manchete.data)}</time>
          <h3 class="manchete__titulo">
            <a class="card__link" href={`/noticias/${manchete.slug}`}>{manchete.titulo}</a>
          </h3>
          <p class="manchete__resumo">{manchete.resumo}</p>
          <span class="manchete__ler" aria-hidden="true">Ler notícia</span>
        </div>
      </article>
      </div>

      <ul class="coluna" role="list" data-revelar="grupo">
        {
          demais.map((noticia) => {
            const d = partesData(noticia.data);
            return (
              <li class="nota">
                <time class="nota__data" datetime={noticia.data}>
                  <span class="nota__dia">{d.dia}</span>
                  <span class="nota__mes">{d.mes}</span>
                </time>
                <div class="nota__texto">
                  <span class="nota__categoria">{noticia.categoria}</span>
                  <h3 class="nota__titulo">
                    <a class="nota__link" href={`/noticias/${noticia.slug}`} data-cursor="Ler">
                      {noticia.titulo}
                    </a>
                  </h3>
                </div>
              </li>
            );
          })
        }
        {
          convite && (
            <li class="convite">
              <div class="convite__arte" aria-hidden="true">
                <Ilustracao nome="megafone" espessura={2.4} />
              </div>
              <p class="convite__titulo">Jogo, mutirão, festa: tem sempre novidade no bairro.</p>
              <a
                class="convite__link"
                href={instagram ?? '/noticias'}
                target={instagram ? '_blank' : undefined}
                rel={instagram ? 'noopener' : undefined}
              >
                {instagram ? 'Siga o Vila no Instagram' : 'Ver todas as notícias'}
                {instagram && <span class="visualmente-oculto"> (abre em nova aba)</span>}
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .noticias {
    padding-block: var(--espaco-secao);
    background: var(--cor-superficie);
  }

  .noticias__cabecalho {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--espaco-4);
    margin-bottom: var(--espaco-7);
    padding-bottom: var(--espaco-5);
    border-bottom: 2px solid var(--verde-900);
  }

  .noticias__chapeu {
    font-family: var(--fonte-titulo);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cor-destaque);
  }

  .noticias h2 {
    font-size: var(--titulo-xl);
    font-weight: 800;
    line-height: 0.9;
    color: var(--verde-900);
  }

  .noticias__grade {
    display: grid;
    gap: var(--espaco-6);
  }

  @media (min-width: 60rem) {
    .noticias__grade {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  /* ---------- Manchete ---------- */
  .manchete {
    border: 0;
    border-radius: var(--raio-lg);
    background: var(--verde-900);
    color: var(--verde-100);
  }

  .manchete__midia {
    position: relative;
  }

  .manchete__categoria {
    position: absolute;
    top: var(--espaco-4);
    left: var(--espaco-4);
    padding: var(--espaco-1) var(--espaco-3);
    border-radius: 999px;
    background: var(--ouro-500);
    color: var(--verde-950);
    font-family: var(--fonte-titulo);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .manchete__corpo {
    display: grid;
    gap: var(--espaco-3);
    padding: var(--espaco-6);
  }

  .manchete__data {
    font-size: var(--texto-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ouro-400);
  }

  .manchete__titulo {
    font-size: var(--titulo-md);
    font-weight: 800;
    line-height: 0.95;
    color: var(--branco);
  }

  .manchete__titulo .card__link {
    background: linear-gradient(var(--ouro-500), var(--ouro-500)) 0 100% / 0% 3px no-repeat;
    transition: background-size 600ms var(--curva-saida);
  }

  .manchete:hover .manchete__titulo .card__link {
    background-size: 100% 3px;
  }

  .manchete__resumo {
    max-width: 52ch;
    color: var(--verde-200);
  }

  .manchete__ler {
    margin-top: var(--espaco-2);
    font-family: var(--fonte-titulo);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ouro-400);
  }

  .manchete__ler::after {
    content: ' →';
    display: inline-block;
    transition: translate 400ms var(--curva-saida);
  }

  .manchete:hover .manchete__ler::after {
    translate: 0.4rem 0;
  }

  /* ---------- Coluna de notas ---------- */
  .coluna {
    display: flex;
    flex-direction: column;
    padding: 0;
    list-style: none;
  }

  .nota {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--espaco-4);
    align-items: start;
    padding-block: var(--espaco-5);
    border-bottom: 1px solid var(--cor-borda);
  }

  .nota:first-child {
    padding-top: 0;
  }

  .nota__data {
    display: grid;
    justify-items: center;
    padding: var(--espaco-2) 0;
    border: 1.5px solid var(--verde-900);
    border-radius: var(--raio);
    font-family: var(--fonte-titulo);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    color: var(--verde-900);
    transition:
      background-color 400ms ease,
      color 400ms ease;
  }

  .nota__dia {
    font-size: 2.25rem;
  }

  .nota__mes {
    font-size: 0.9375rem;
    letter-spacing: 0.12em;
    color: var(--cor-destaque);
  }

  .nota:hover .nota__data {
    background: var(--verde-900);
    color: var(--branco);
  }

  .nota:hover .nota__mes {
    color: var(--ouro-400);
  }

  .nota__texto {
    display: grid;
    gap: var(--espaco-1);
  }

  .nota__categoria {
    font-family: var(--fonte-titulo);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--verde-700);
  }

  .nota__titulo {
    font-size: var(--titulo-sm);
    font-weight: 800;
    line-height: 1;
  }

  .nota__link {
    color: var(--verde-900);
    text-decoration: none;
    background: linear-gradient(var(--ouro-500), var(--ouro-500)) 0 100% / 0% 2px no-repeat;
    transition: background-size 500ms var(--curva-saida);
  }

  .nota__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .nota:hover .nota__link {
    background-size: 100% 2px;
  }

  /* ---------- Convite para as redes (completa a coluna quando há poucas notícias) ---------- */
  .convite {
    position: relative;
    display: grid;
    gap: var(--espaco-3);
    align-content: end;
    flex: 1;
    min-height: 15rem;
    margin-top: var(--espaco-5);
    padding: var(--espaco-6);
    border-radius: var(--raio-lg);
    background:
      radial-gradient(circle at 85% 20%, rgb(255 255 255 / 0.35), transparent 50%),
      var(--ouro-500);
    color: var(--verde-950);
    overflow: hidden;
  }

  .convite:first-child {
    margin-top: 0;
  }

  .convite__arte {
    position: absolute;
    top: var(--espaco-4);
    right: var(--espaco-4);
    width: clamp(8rem, 5rem + 8vw, 13rem);
    color: var(--verde-900);
    --ilustracao-destaque: var(--branco);
  }

  .convite__arte :global(.ilustracao) {
    width: 100%;
    height: auto;
  }

  .convite__titulo {
    max-width: 14ch;
    font-family: var(--fonte-titulo);
    font-size: var(--titulo-md);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .convite__link {
    justify-self: start;
    font-family: var(--fonte-titulo);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--verde-950);
    text-decoration: none;
  }

  .convite__link::before {
    content: '';
    position: absolute;
    inset: 0;
  }

  .convite__link::after {
    content: ' →';
    display: inline-block;
    transition: translate 400ms var(--curva-saida);
  }

  .convite:hover .convite__link::after {
    translate: 0.4rem 0;
  }

  .convite:has(.convite__link:focus-visible) {
    outline: 3px solid var(--verde-900);
    outline-offset: 2px;
  }
</style>
