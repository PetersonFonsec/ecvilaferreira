---
/**
 * Metadados de SEO e compartilhamento (Open Graph, Twitter Cards, canonical, JSON-LD).
 * `imagem` deve ser uma URL absoluta ou um caminho a partir da raiz do site.
 */
interface Props {
  titulo: string;
  descricao: string;
  nomeSite: string;
  imagem?: string;
  imagemAlt?: string;
  tipo?: 'website' | 'article';
  publicadoEm?: string;
  semIndexar?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  titulo,
  descricao,
  nomeSite,
  imagem = '/og-padrao.png',
  imagemAlt = nomeSite,
  tipo = 'website',
  publicadoEm,
  semIndexar = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(imagem, Astro.site).toString();
const tituloCompleto = titulo === nomeSite ? titulo : `${titulo} | ${nomeSite}`;
---

<title>{tituloCompleto}</title>
<meta name="description" content={descricao} />
<link rel="canonical" href={canonical} />
{semIndexar && <meta name="robots" content="noindex" />}

<meta property="og:type" content={tipo} />
<meta property="og:site_name" content={nomeSite} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descricao} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagemAbsoluta} />
<meta property="og:image:alt" content={imagemAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publicadoEm && <meta property="article:published_time" content={publicadoEm} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descricao} />
<meta name="twitter:image" content={imagemAbsoluta} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
