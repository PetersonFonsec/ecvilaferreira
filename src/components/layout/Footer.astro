---
import Escudo from '@/components/ui/Escudo.astro';
import { menuRodape } from '@/data/navegacao';
import { linkWhatsApp } from '@/lib/whatsapp';
import type { Configuracoes } from '@/lib/types';

interface Props {
  config: Configuracoes;
}
const { config } = Astro.props;

const redes = [
  { rotulo: 'Instagram', href: config.instagram },
  { rotulo: 'Facebook', href: config.facebook },
  { rotulo: 'YouTube', href: config.youtube },
].filter((rede) => rede.href);
---

<footer class="rodape">
  <div class="container rodape__grade">
    <div class="rodape__clube pilha">
      <p class="rodape__marca">
        <Escudo tamanho={48} />
        <span>{config.nome}</span>
      </p>
      <p class="rodape__slogan">{config.slogan}</p>
      <p>
        Fundado em {config.fundacao} · {config.cidade}
        {config.endereco && <><br />{config.endereco}</>}
      </p>
    </div>

    {
      menuRodape.map((grupo) => (
        <nav class="rodape__grupo" aria-label={grupo.titulo}>
          <h2 class="rodape__titulo">{grupo.titulo}</h2>
          <ul role="list">
            {grupo.itens.map((item) => (
              <li>
                <a href={item.href}>{item.rotulo}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="rodape__grupo">
      <h2 class="rodape__titulo">Fale com a gente</h2>
      <ul role="list">
        <li><a href={linkWhatsApp(config.whatsapp)} rel="noopener">WhatsApp</a></li>
        {config.email && <li><a href={`mailto:${config.email}`}>{config.email}</a></li>}
        {redes.map((rede) => <li><a href={rede.href} rel="noopener">{rede.rotulo}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="container rodape__base">
    <p>© {new Date().getFullYear()} {config.nome}. Feito no bairro, com o bairro.</p>
    <a class="rodape__topo" href="#conteudo" data-magnetico="0.4" data-cursor="Topo">
      Voltar ao topo
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M12 19V5M6 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>

  <p class="rodape__gigante" aria-hidden="true" data-revelar>
    <span>Vila</span>
    <Escudo tamanho={160} class="rodape__gigante-escudo" />
    <span>Ferreira</span>
  </p>
</footer>

<style>
  .rodape {
    margin-top: var(--espaco-secao);
    overflow: clip;
    background: var(--verde-950);
    color: var(--verde-200);
    border-top: 3px solid var(--ouro-500);
    font-size: var(--texto-sm);
  }

  /* Na home, a última seção já é escura e encosta no rodapé. */
  :global(main:has(> .loja-chamada:last-child)) + .rodape {
    margin-top: 0;
  }

  .rodape__grade {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: var(--espaco-6);
    padding-block: var(--espaco-7);
  }

  .rodape__clube {
    grid-column: 1 / -1;
    max-width: 28rem;
  }

  @media (min-width: 64rem) {
    .rodape__grade {
      grid-template-columns: 1.6fr repeat(5, 1fr);
    }

    .rodape__clube {
      grid-column: auto;
    }
  }

  .rodape__marca {
    display: flex;
    align-items: center;
    gap: var(--espaco-3);
    font-family: var(--fonte-titulo);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--branco);
  }

  .rodape__slogan {
    font-family: var(--fonte-titulo);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--branco);
  }

  .rodape__titulo {
    margin-bottom: var(--espaco-3);
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: var(--branco);
  }

  .rodape ul {
    display: grid;
    gap: var(--espaco-2);
    padding: 0;
    list-style: none;
  }

  .rodape a {
    color: var(--verde-100);
    text-decoration: none;
    background: linear-gradient(var(--ouro-500), var(--ouro-500)) 0 100% / 0% 1px no-repeat;
    transition:
      background-size 450ms var(--curva-saida),
      color 200ms ease;
  }

  .rodape a:hover {
    color: var(--ouro-400);
    background-size: 100% 1px;
  }

  .rodape__titulo {
    color: var(--ouro-400) !important;
  }

  .rodape__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espaco-4);
    padding-block: var(--espaco-4);
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .rodape .rodape__topo {
    display: inline-flex;
    align-items: center;
    gap: var(--espaco-2);
    padding: var(--espaco-2) var(--espaco-4);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    font-family: var(--fonte-titulo);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: none;
  }

  .rodape .rodape__topo:hover {
    border-color: var(--ouro-500);
  }

  /* Assinatura gigante no fim da página. */
  .rodape__gigante {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.15em;
    padding-bottom: var(--espaco-5);
    font-family: var(--fonte-titulo);
    font-size: clamp(3rem, 15vw, 15rem);
    font-weight: 800;
    line-height: 0.8;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(242 203 44 / 0.5);
    user-select: none;
  }

  .rodape__gigante :global(.rodape__gigante-escudo) {
    width: 0.8em;
    height: auto;
    flex: none;
  }
</style>
