---
import type { ItemMenu } from '@/data/navegacao';

interface Props {
  itens: ItemMenu[];
  destaque?: ItemMenu;
  id?: string;
}

const { itens, destaque, id } = Astro.props;
const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
const ativo = (href: string) => atual === href || atual.startsWith(`${href}/`);
---

<nav id={id} class="nav" aria-label="Principal">
  <ul class="nav__lista" role="list">
    {
      itens.map((item, i) => (
        <li style={`--i: ${i}`}>
          <a class="nav__link" href={item.href} aria-current={ativo(item.href) ? 'page' : undefined}>
            <span class="nav__rolo" data-texto={item.rotulo}>
              <span>{item.rotulo}</span>
            </span>
          </a>
        </li>
      ))
    }
    {
      destaque && (
        <li style={`--i: ${itens.length}`}>
          <a
            class="nav__destaque"
            href={destaque.href}
            aria-current={ativo(destaque.href) ? 'page' : undefined}
            data-magnetico="0.3"
          >
            {destaque.rotulo}
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M12 21s-7.5-4.6-9.5-9.2C1 8.2 3.4 4.5 7 4.5c2.1 0 3.6 1.1 5 3 1.4-1.9 2.9-3 5-3 3.6 0 6 3.7 4.5 7.3C19.5 16.4 12 21 12 21Z" fill="currentColor" />
            </svg>
          </a>
        </li>
      )
    }
  </ul>
</nav>

<style>
  .nav__lista {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espaco-1) var(--espaco-2);
    padding: 0;
    list-style: none;
  }

  .nav__link,
  .nav__destaque {
    display: inline-flex;
    align-items: center;
    gap: var(--espaco-2);
    padding: var(--espaco-2) var(--espaco-3);
    font-family: var(--fonte-titulo);
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-radius: 999px;
  }

  .nav__link {
    position: relative;
    color: var(--cor-sobre-marca);
  }

  /* Efeito "rolo": o texto sobe e uma cópia dourada entra por baixo. */
  .nav__rolo {
    position: relative;
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .nav__rolo > span,
  .nav__rolo::after {
    display: block;
    transition: translate 550ms var(--curva-saida);
  }

  .nav__rolo::after {
    content: attr(data-texto);
    position: absolute;
    inset: 0;
    translate: 0 100%;
    color: var(--ouro-400);
  }

  .nav__link:hover .nav__rolo > span,
  .nav__link:hover .nav__rolo::after {
    translate: 0 -100%;
  }

  .nav__link:hover .nav__rolo::after {
    translate: 0 0;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.2rem;
    width: 0.375rem;
    height: 0.375rem;
    margin-left: -0.1875rem;
    border-radius: 50%;
    background: var(--ouro-500);
    scale: 0;
    transition: scale 400ms var(--curva-saida);
  }

  .nav__link[aria-current='page']::after {
    scale: 1;
  }

  .nav__destaque {
    background: var(--ouro-500);
    color: var(--verde-950);
    padding-inline: var(--espaco-4);
    transition: background-color var(--transicao);
  }

  .nav__destaque:hover {
    background: var(--ouro-400);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__rolo::after {
      display: none;
    }

    .nav__link:hover .nav__rolo > span {
      translate: none;
      text-decoration: underline;
    }
  }
</style>
