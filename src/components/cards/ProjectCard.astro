---
import Midia from '@/components/ui/Midia.astro';
import type { ProjetoSocial } from '@/lib/types';

interface Props {
  projeto: ProjetoSocial;
  nivelTitulo?: 'h2' | 'h3';
}
const { projeto, nivelTitulo: Titulo = 'h3' } = Astro.props;
---

<article class="card">
  <Midia imagem={projeto.imagem} />
  <div class="card__corpo">
    <p class="card__meta"><span class="etiqueta">{projeto.status}</span></p>
    <Titulo class="card__titulo">
      <a class="card__link" href={`/projetos/${projeto.slug}`}>{projeto.titulo}</a>
    </Titulo>
    <p>{projeto.resumo}</p>
  </div>
</article>
