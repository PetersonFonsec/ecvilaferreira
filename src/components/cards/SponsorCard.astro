---
import type { Patrocinador } from '@/lib/types';
import { urlImagem } from '@/lib/imagem';

interface Props {
  patrocinador: Patrocinador;
}
const { patrocinador } = Astro.props;
const Elemento = patrocinador.site ? 'a' : 'div';
---

<Elemento
  class:list={['patrocinador', `patrocinador--${patrocinador.nivel.toLowerCase()}`]}
  href={patrocinador.site}
  rel={patrocinador.site ? 'noopener sponsored' : undefined}
>
  {
    patrocinador.logo ? (
      <img
        class="patrocinador__logo"
        src={urlImagem(patrocinador.logo, { h: 160, auto: 'format,compress' })}
        alt={patrocinador.nome}
        height="80"
        width={patrocinador.logo.width && patrocinador.logo.height ? Math.round((80 * patrocinador.logo.width) / patrocinador.logo.height) : undefined}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="patrocinador__nome">{patrocinador.nome}</span>
    )
  }
  <span class="patrocinador__nivel">{patrocinador.nivel}</span>
</Elemento>

<style>
  .patrocinador {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--espaco-3);
    min-height: 9rem;
    height: 100%;
    padding: var(--espaco-5);
    background: var(--cor-superficie);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio);
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  a.patrocinador:hover {
    box-shadow: var(--sombra);
  }

  .patrocinador--master {
    border: 2px solid var(--cor-conquista);
  }

  .patrocinador__logo {
    max-height: 5rem;
    width: auto;
    object-fit: contain;
  }

  .patrocinador__nome {
    font-family: var(--fonte-titulo);
    font-size: 1.375rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .patrocinador__nivel {
    font-size: var(--texto-sm);
    color: var(--cor-texto-suave);
  }
</style>
