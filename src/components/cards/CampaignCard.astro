---
import Midia from '@/components/ui/Midia.astro';
import ProgressBar from '@/components/ui/ProgressBar.astro';
import type { Campanha } from '@/lib/types';

interface Props {
  campanha: Campanha;
  nivelTitulo?: 'h2' | 'h3';
}
const { campanha, nivelTitulo: Titulo = 'h3' } = Astro.props;
---

<article class="card" data-inclinar="5" data-cursor="Ver">
  <Midia imagem={campanha.imagem} />
  <div class="card__corpo">
    <p class="card__meta">
      <span class:list={['etiqueta', { 'etiqueta--destaque': campanha.status === 'Ativa', 'etiqueta--neutra': campanha.status === 'Encerrada' }]}>
        {campanha.status}
      </span>
    </p>
    <Titulo class="card__titulo">
      <a class="card__link" href={`/campanhas/${campanha.slug}`}>{campanha.titulo}</a>
    </Titulo>
    <p>{campanha.resumo}</p>
    <div class="card__rodape">
      <ProgressBar arrecadado={campanha.arrecadado} meta={campanha.meta} compacto />
    </div>
  </div>
</article>
