---
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import Escudo from '@/components/ui/Escudo.astro';
import type { Imagem } from '@/lib/types';

/** Imagem de card. Sem imagem cadastrada, mostra um fundo com o brasão do clube. */
interface Props {
  imagem?: Imagem;
  proporcao?: number;
  sizes?: string;
}
const { imagem, proporcao = 16 / 10, sizes } = Astro.props;
---

<div class="card__moldura" style={`aspect-ratio: ${proporcao}`}>
  {
    imagem ? (
      <ResponsiveImage imagem={imagem} proporcao={proporcao} sizes={sizes} class="card__midia" />
    ) : (
      <div class="card__midia midia-vazia" aria-hidden="true">
        <Escudo tamanho={64} class="midia-vazia__escudo" />
      </div>
    )
  }
</div>

<style>
  .card__moldura {
    overflow: hidden;
    background: var(--cor-marca-suave);
  }

  .card__moldura > :global(*) {
    width: 100%;
    height: 100%;
    transition: scale 900ms var(--curva-saida);
  }

  :global(.card:hover) .card__moldura > :global(*) {
    scale: 1.06;
  }

  .midia-vazia {
    display: grid;
    place-items: center;
    background-color: var(--verde-800);
    background-image:
      radial-gradient(circle at 50% 60%, rgb(242 203 44 / 0.18), transparent 60%),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.05) 0 2rem, transparent 2rem 4rem);
  }

  .midia-vazia :global(.midia-vazia__escudo) {
    transition: rotate 900ms var(--curva-saida);
  }

  :global(.card:hover) .midia-vazia :global(.midia-vazia__escudo) {
    rotate: -10deg;
  }
</style>
