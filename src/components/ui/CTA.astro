---
import Botao from '@/components/ui/Botao.astro';

/** Chamada para ação: título curto, texto e até dois botões. */
interface Props {
  titulo: string;
  texto?: string;
  acao: { rotulo: string; href: string; externo?: boolean };
  acaoSecundaria?: { rotulo: string; href: string; externo?: boolean };
}

const { titulo, texto, acao, acaoSecundaria } = Astro.props;
---

<aside class="cta" data-revelar="zoom">
  <div class="cta__texto">
    <h2 class="cta__titulo">{titulo}</h2>
    {texto && <p>{texto}</p>}
  </div>
  <div class="cta__acoes">
    <Botao href={acao.href} variante="ouro" externo={acao.externo}>{acao.rotulo}</Botao>
    {
      acaoSecundaria && (
        <a class="cta__link" href={acaoSecundaria.href} target={acaoSecundaria.externo ? '_blank' : undefined} rel={acaoSecundaria.externo ? 'noopener' : undefined}>
          {acaoSecundaria.rotulo}
        </a>
      )
    }
  </div>
</aside>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espaco-5);
    padding: clamp(var(--espaco-5), 4vw, var(--espaco-7));
    background: var(--cor-marca-forte);
    color: var(--cor-sobre-marca);
    border-radius: var(--raio-lg);
    border-left: 8px solid var(--ouro-500);
    background-image: radial-gradient(ellipse 60% 90% at 100% 50%, rgb(17 128 51 / 0.55), transparent 70%);
  }

  .cta__texto {
    display: grid;
    gap: var(--espaco-2);
    max-width: 36rem;
  }

  .cta__titulo {
    font-size: var(--titulo-md);
    font-weight: 800;
  }

  .cta__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espaco-4);
  }

  .cta__link {
    color: var(--branco);
    font-weight: 600;
  }
</style>
