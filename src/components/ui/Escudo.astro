---
import { svgBrasao } from '@/lib/brasao';

/**
 * Brasão oficial do Esporte Clube Vila Ferreira (o desenho fica em src/lib/brasao.ts).
 * `simples` remove os textos (para tamanhos pequenos, onde as letras não seriam legíveis).
 * `estrelas={false}` esconde as duas estrelas douradas de cima.
 */
interface Props {
  tamanho?: number;
  class?: string;
  simples?: boolean;
  estrelas?: boolean;
  /** Texto alternativo. Sem ele, o brasão é tratado como decorativo. */
  rotulo?: string;
}

const { tamanho = 40, class: classe, simples = false, estrelas = true, rotulo } = Astro.props;
const svg = svgBrasao({ tamanho, classe: ['escudo', classe].filter(Boolean).join(' '), simples, estrelas, rotulo });
---

<Fragment set:html={svg} />
