---
/**
 * Faixa de texto que corre sem parar. Com JS, acelera e muda de sentido conforme a rolagem.
 * O conteúdo é repetido para o laço não ter emenda; leitores de tela ouvem só a primeira cópia.
 */
interface Props {
  itens: string[];
  tom?: 'ouro' | 'verde';
  velocidade?: number;
}

const { itens, tom = 'ouro', velocidade = 1 } = Astro.props;
// Repete o bastante para cobrir telas largas.
const bloco = [...itens, ...itens];
---

<div class:list={['letreiro', `letreiro--${tom}`]} data-letreiro={velocidade}>
  <p class="visualmente-oculto">{itens.join(' · ')}</p>
  <div class="letreiro__faixa" aria-hidden="true">
    {
      [0, 1].map(() => (
        <span class="letreiro__bloco">
          {bloco.map((item) => (
            <span class="letreiro__item">
              {item}
              <svg viewBox="0 0 24 24" width="28" height="28" focusable="false">
                <path d="M12 1.5l3.1 6.9 7.4.7-5.6 5 1.7 7.4L12 17.8l-6.6 3.7 1.7-7.4-5.6-5 7.4-.7z" fill="currentColor" />
              </svg>
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .letreiro {
    padding-block: var(--espaco-4);
    font-family: var(--fonte-titulo);
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .letreiro--ouro {
    background: var(--ouro-500);
    color: var(--verde-950);
  }

  .letreiro--verde {
    background: var(--verde-700);
    color: var(--branco);
  }

  .letreiro__bloco,
  .letreiro__item {
    display: inline-flex;
    align-items: center;
  }

  .letreiro__item {
    gap: var(--espaco-5);
    padding-right: var(--espaco-5);
  }

  .letreiro__item svg {
    width: 0.7em;
    height: 0.7em;
  }

  .letreiro--ouro .letreiro__item svg {
    color: var(--verde-700);
  }

  .letreiro--verde .letreiro__item svg {
    color: var(--ouro-500);
  }
</style>
