---
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import Escudo from '@/components/ui/Escudo.astro';
import Ilustracao from '@/components/ui/Ilustracao.astro';
import type { NomeIlustracao } from '@/data/ilustracoes';
import type { Imagem } from '@/lib/types';

/**
 * Abertura de página. `variante="inicio"` é a versão de tela cheia da home, com o brasão em 3D;
 * `variante="pagina"` é o cabeçalho das páginas internas, com uma ilustração opcional à direita.
 */
interface Props {
  titulo: string;
  chapeu?: string;
  texto?: string;
  imagem?: Imagem;
  ilustracao?: NomeIlustracao;
  variante?: 'inicio' | 'pagina';
}

const { titulo, chapeu, texto, imagem, ilustracao, variante = 'pagina' } = Astro.props;

// Na home, a primeira frase do slogan vira o título gigante e o resto entra como linha de apoio.
const [principal, ...resto] = variante === 'inicio' ? titulo.split(/(?<=\.)\s+/) : [titulo];
const apoio = resto.join(' ');
const anel = 'Esporte Clube Vila Ferreira • Desde 1984 • São Bernardo do Campo • ';
---

<section
  class:list={['hero', `hero--${variante}`, { 'hero--com-imagem': imagem, 'hero--com-ilustracao': ilustracao }]}
>
  {
    imagem && (
      <div class="hero__fundo" data-parallax="-0.25">
        <ResponsiveImage imagem={imagem} class="hero__imagem" sizes="100vw" prioridade />
      </div>
    )
  }

  {
    variante === 'inicio' && (
      <div class="hero__campo" aria-hidden="true" data-parallax="-0.12">
        <Ilustracao nome="campo" espessura={2} />
      </div>
    )
  }

  <div class="container hero__conteudo">
    <div class="hero__textos">
      {chapeu && <p class="hero__chapeu" data-revelar style="--atraso: 150ms">{chapeu}</p>}
      <h1 class="hero__titulo" data-dividir>{principal}</h1>
      {apoio && <p class="hero__apoio" data-revelar style="--atraso: 500ms">{apoio}</p>}
      {texto && <p class="hero__texto" data-revelar style="--atraso: 650ms">{texto}</p>}
      <div class="hero__acoes" data-revelar style="--atraso: 800ms">
        <slot />
      </div>
    </div>

    {
      variante === 'inicio' && (
        <div class="hero__palco" data-escudo-3d data-cursor="Gire">
          <svg class="hero__anel" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
            <defs>
              <path id="hero-anel" d="M200,200m-180,0a180,180 0 1,1 360,0a180,180 0 1,1 -360,0" />
            </defs>
            <text>
              <textPath href="#hero-anel" textLength="1120" lengthAdjust="spacing">
                {anel}
              </textPath>
            </text>
          </svg>
          <div class="hero__brilho" aria-hidden="true" />
          <Escudo tamanho={320} class="hero__escudo" rotulo="Brasão do Esporte Clube Vila Ferreira" />
        </div>
      )
    }

    {
      variante === 'pagina' && ilustracao && (
        <div class="hero__ilustracao" data-seguir="-24">
          <Ilustracao nome={ilustracao} atraso={300} />
        </div>
      )
    }
  </div>

  {
    variante === 'inicio' && (
      <a class="hero__rolar" href="#conteudo-inicio" aria-label="Role até o conteúdo">
        <span class="hero__rolar-bola" aria-hidden="true" />
        <span aria-hidden="true">Role</span>
      </a>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background-color: var(--verde-900);
    /* Faixas de gramado cortado, como num campo de várzea bem cuidado. */
    background-image:
      radial-gradient(ellipse 70% 60% at 75% 40%, rgb(17 128 51 / 0.55), transparent 70%),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.035) 0 5rem, transparent 5rem 10rem);
    color: var(--cor-sobre-marca);
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: 30%;
    background: linear-gradient(to top, var(--verde-950), transparent);
    pointer-events: none;
  }

  .hero__fundo {
    position: absolute;
    inset: -15% 0;
    z-index: -2;
  }

  .hero :global(.hero__imagem) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero--com-imagem::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(3 26 11 / 0.94) 0%, rgb(3 26 11 / 0.6) 70%, rgb(3 26 11 / 0.35));
  }

  .hero__campo {
    position: absolute;
    inset: 8% -10% auto;
    z-index: -1;
    color: rgb(255 255 255 / 0.11);
    pointer-events: none;
  }

  .hero__campo :global(.ilustracao) {
    width: 100%;
    height: auto;
    transform: perspective(1200px) rotateX(55deg) scale(1.15);
    transform-origin: 50% 0;
  }

  .hero__conteudo {
    display: grid;
    gap: var(--espaco-6);
    align-items: center;
    padding-block: var(--espaco-7) var(--espaco-8);
  }

  .hero__textos {
    display: grid;
    gap: var(--espaco-4);
    justify-items: start;
  }

  .hero__chapeu {
    display: inline-flex;
    align-items: center;
    gap: var(--espaco-2);
    font-family: var(--fonte-titulo);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ouro-400);
  }

  .hero__chapeu::before {
    content: '';
    width: 2.5rem;
    height: 2px;
    background: currentColor;
  }

  .hero__titulo {
    max-width: 16ch;
  }

  .hero__apoio {
    max-width: 22ch;
    font-family: var(--fonte-titulo);
    font-size: var(--titulo-md);
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ouro-500);
  }

  .hero__texto {
    max-width: var(--largura-texto);
    font-size: var(--texto-lg);
    color: var(--verde-100);
  }

  .hero__acoes:empty {
    display: none;
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-3);
    margin-top: var(--espaco-2);
  }

  /* ---------- Home ---------- */
  .hero--inicio .hero__conteudo {
    min-height: calc(100svh - 4.5rem);
    padding-block: var(--espaco-6) var(--espaco-8);
  }

  .hero--inicio .hero__titulo {
    max-width: 10ch;
    font-size: var(--titulo-gigante);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.01em;
  }

  @media (min-width: 60rem) {
    .hero--inicio .hero__conteudo {
      grid-template-columns: 1.15fr 1fr;
    }

    .hero--com-ilustracao .hero__conteudo {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .hero__palco {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 34rem);
    aspect-ratio: 1;
    justify-self: center;
    touch-action: pan-y;
  }

  .hero__palco > :global(*) {
    grid-area: 1 / 1;
  }

  .hero :global(.hero__escudo) {
    width: 62%;
    height: auto;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.35));
    transition:
      opacity 900ms ease,
      scale 1200ms var(--curva-saida);
  }

  /* Absoluto para o tamanho do canvas não empurrar o palco (e o ResizeObserver não entrar em laço). */
  .hero__palco :global(.escudo3d__canvas) {
    position: absolute;
    inset: -10%;
    z-index: 1;
    width: 120%;
    height: 120%;
    opacity: 0;
    transition: opacity 1200ms ease;
  }

  .hero__palco:global(.escudo3d--pronto) :global(.escudo3d__canvas) {
    opacity: 1;
  }

  .hero__palco:global(.escudo3d--pronto) :global(.hero__escudo) {
    opacity: 0;
    scale: 0.9;
  }

  .hero__palco:global(.escudo3d--arrastando) {
    cursor: grabbing;
  }

  .hero__brilho {
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(242 203 44 / 0.35), rgb(242 203 44 / 0) 65%);
    filter: blur(20px);
  }

  .hero__anel {
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--fonte-titulo);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    fill: rgb(255 255 255 / 0.55);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__anel {
      animation: girar 40s linear infinite;
    }

    .hero__brilho {
      animation: pulsar 5s ease-in-out infinite;
    }
  }

  @keyframes girar {
    to {
      rotate: 360deg;
    }
  }

  @keyframes pulsar {
    50% {
      scale: 1.12;
      opacity: 0.7;
    }
  }

  .hero__rolar {
    position: absolute;
    left: 50%;
    bottom: var(--espaco-5);
    display: grid;
    justify-items: center;
    gap: var(--espaco-2);
    translate: -50% 0;
    color: var(--verde-100);
    font-family: var(--fonte-titulo);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hero__rolar-bola {
    position: relative;
    width: 1.5rem;
    height: 2.5rem;
    border: 2px solid currentColor;
    border-radius: 999px;
  }

  .hero__rolar-bola::after {
    content: '';
    position: absolute;
    top: 0.4rem;
    left: 50%;
    width: 0.375rem;
    height: 0.375rem;
    margin-left: -0.1875rem;
    border-radius: 50%;
    background: var(--ouro-500);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__rolar-bola::after {
      animation: rolar 1.8s var(--curva-entra-sai) infinite;
    }
  }

  @keyframes rolar {
    60% {
      translate: 0 1rem;
      opacity: 0;
    }
    61% {
      translate: 0 0;
      opacity: 0;
    }
  }

  /* ---------- Páginas internas ---------- */
  .hero--pagina .hero__titulo {
    font-size: var(--titulo-xl);
    font-weight: 800;
    line-height: 0.95;
  }

  .hero--pagina .hero__conteudo {
    min-height: min(60svh, 32rem);
  }

  .hero__ilustracao {
    justify-self: center;
    width: min(70%, 20rem);
    color: var(--branco);
  }

  .hero__ilustracao :global(.ilustracao) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 59.9375rem), (max-height: 44rem) {
    .hero__rolar {
      display: none;
    }
  }

  @media (max-width: 59.9375rem) {
    .hero__ilustracao {
      display: none;
    }

    .hero--inicio .hero__palco {
      width: min(80%, 22rem);
      order: -1;
    }
  }
</style>
