---
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import type { Imagem } from '@/lib/types';

/**
 * Abertura de página. `variante="inicio"` é a versão grande da home;
 * `variante="pagina"` é o cabeçalho das páginas internas.
 */
interface Props {
  titulo: string;
  chapeu?: string;
  texto?: string;
  imagem?: Imagem;
  variante?: 'inicio' | 'pagina';
}

const { titulo, chapeu, texto, imagem, variante = 'pagina' } = Astro.props;
---

<section class:list={['hero', `hero--${variante}`, { 'hero--com-imagem': imagem }]}>
  {imagem && <ResponsiveImage imagem={imagem} class="hero__imagem" sizes="100vw" prioridade />}
  <div class="container hero__conteudo">
    {chapeu && <p class="hero__chapeu">{chapeu}</p>}
    <h1 class="hero__titulo">{titulo}</h1>
    {texto && <p class="hero__texto">{texto}</p>}
    <div class="hero__acoes">
      <slot />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--cor-marca);
    /* Faixas de gramado cortado, como num campo de várzea bem cuidado. */
    background-image: repeating-linear-gradient(
      90deg,
      rgb(255 255 255 / 0.04) 0 4rem,
      transparent 4rem 8rem
    );
    color: var(--cor-sobre-marca);
  }

  /* Linha do meio-campo e círculo central, apenas decorativos. */
  .hero--inicio::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -6rem;
    width: clamp(14rem, 40vw, 30rem);
    aspect-ratio: 1;
    border: 3px solid rgb(255 255 255 / 0.18);
    border-radius: 50%;
    transform: translateY(-50%);
  }

  .hero :global(.hero__imagem) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero--com-imagem::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(7 42 23 / 0.92) 0%, rgb(7 42 23 / 0.55) 70%, rgb(7 42 23 / 0.3));
  }

  .hero__conteudo {
    display: grid;
    gap: var(--espaco-4);
    padding-block: var(--espaco-7);
  }

  .hero--inicio .hero__conteudo {
    min-height: min(80svh, 40rem);
    align-content: center;
    padding-block: var(--espaco-8);
  }

  .hero__chapeu {
    justify-self: start;
    padding: var(--espaco-1) var(--espaco-3);
    background: var(--branco);
    color: var(--cor-marca-forte);
    font-family: var(--fonte-titulo);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: var(--raio-sm);
  }

  .hero__titulo {
    max-width: 18ch;
  }

  .hero--inicio .hero__titulo {
    font-size: var(--titulo-xl);
  }

  .hero__texto {
    max-width: var(--largura-texto);
    font-size: var(--texto-lg);
    color: var(--verde-100);
  }

  .hero__acoes:empty {
    display: none;
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-3);
    margin-top: var(--espaco-2);
  }
</style>
