---
/**
 * Seção de página com título opcional. Use `tom` para alternar o fundo entre seções.
 */
interface Props {
  titulo?: string;
  subtitulo?: string;
  /** Rótulo pequeno acima do título (ex.: "Comunidade"). */
  chapeu?: string;
  tom?: 'padrao' | 'claro' | 'marca' | 'escuro';
  id?: string;
  class?: string;
}

const { titulo, subtitulo, chapeu, tom = 'padrao', id, class: classe } = Astro.props;
const idTitulo = id ? `${id}-titulo` : undefined;
---

<section class:list={['secao', `secao--${tom}`, classe]} id={id} aria-labelledby={titulo ? idTitulo : undefined}>
  <div class="container">
    {
      titulo && (
        <header class="secao__cabecalho">
          {chapeu && <p class="secao__chapeu" data-revelar>{chapeu}</p>}
          <h2 id={idTitulo} data-dividir>{titulo}</h2>
          {subtitulo && <p class="secao__subtitulo" data-revelar style="--atraso: 200ms">{subtitulo}</p>}
          <slot name="acao" />
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .secao {
    padding-block: var(--espaco-secao);
  }

  .secao--claro {
    background: var(--cor-superficie);
  }

  .secao--marca {
    background: var(--cor-marca);
    color: var(--cor-sobre-marca);
  }

  .secao--escuro {
    background: var(--verde-950);
    color: var(--verde-100);
  }

  .secao--marca :global(a:not([class])),
  .secao--escuro :global(a:not([class])) {
    color: inherit;
  }

  .secao h2 {
    font-size: var(--titulo-lg);
    font-weight: 800;
    line-height: 0.95;
  }

  .secao--escuro h2 {
    color: var(--branco);
  }

  .secao__cabecalho {
    display: grid;
    gap: var(--espaco-2);
    max-width: var(--largura-texto);
    margin-bottom: var(--espaco-6);
  }

  .secao__chapeu {
    display: inline-flex;
    align-items: center;
    gap: var(--espaco-2);
    font-family: var(--fonte-titulo);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cor-destaque);
  }

  .secao__chapeu::before {
    content: '';
    width: 0.625rem;
    height: 0.625rem;
    background: var(--ouro-500);
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }

  .secao--marca .secao__chapeu,
  .secao--escuro .secao__chapeu {
    color: var(--ouro-400);
  }

  .secao__subtitulo {
    font-size: var(--texto-lg);
    color: var(--cor-texto-suave);
  }

  .secao--marca .secao__subtitulo,
  .secao--escuro .secao__subtitulo {
    color: var(--verde-200);
  }
</style>
