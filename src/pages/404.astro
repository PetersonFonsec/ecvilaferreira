---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/ui/Hero.astro';
import Botao from '@/components/ui/Botao.astro';
---

<BaseLayout titulo="Página não encontrada" descricao="A página que você procurou não existe." semIndexar>
  <Hero ilustracao="bola" chapeu="Bola fora" titulo="Página não encontrada" texto="O link pode estar errado ou a página foi removida.">
    <Botao href="/" variante="claro">Voltar para o início</Botao>
  </Hero>
</BaseLayout>
