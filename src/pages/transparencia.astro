---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/ui/Hero.astro';
import Section from '@/components/ui/Section.astro';
import { getCampanhas } from '@/lib/content';
import { formatarData, formatarMoeda, percentual } from '@/lib/format';

const campanhas = await getCampanhas();
const total = campanhas.reduce((soma, c) => soma + c.arrecadado, 0);
---

<BaseLayout titulo="Transparência" descricao="Prestação de contas das campanhas e doações do Vila Ferreira.">
  <Hero ilustracao="prancheta" chapeu="Apoie" titulo="Transparência" texto="Quem doa merece saber para onde vai cada real. Aqui está o resumo de todas as campanhas." />

  <Section titulo="Campanhas" id="campanhas">
    <p class="total">Total arrecadado em campanhas: <strong>{formatarMoeda(total)}</strong></p>
    <div class="tabela-rolagem" tabindex="0" role="region" aria-label="Tabela de campanhas">
      <table>
        <caption class="visualmente-oculto">Campanhas, metas e valores arrecadados</caption>
        <thead>
          <tr>
            <th scope="col">Campanha</th>
            <th scope="col">Status</th>
            <th scope="col">Período</th>
            <th scope="col" class="num">Meta</th>
            <th scope="col" class="num">Arrecadado</th>
            <th scope="col" class="num">%</th>
          </tr>
        </thead>
        <tbody>
          {
            campanhas.map((c) => (
              <tr>
                <th scope="row"><a href={`/campanhas/${c.slug}`}>{c.titulo}</a></th>
                <td>{c.status}</td>
                <td>{[c.dataInicio, c.dataFim].filter((d): d is string => Boolean(d)).map(formatarData).join(' a ') || '—'}</td>
                <td class="num">{formatarMoeda(c.meta)}</td>
                <td class="num">{formatarMoeda(c.arrecadado)}</td>
                <td class="num">{percentual(c.arrecadado, c.meta)}%</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="texto-suave nota">
      Os valores são informados pela diretoria e atualizados manualmente. Dúvidas? <a href="/contato">Fale com a gente</a>.
    </p>
  </Section>
</BaseLayout>

<style>
  .total {
    margin-bottom: var(--espaco-5);
    font-size: var(--texto-lg);
  }

  .tabela-rolagem {
    overflow-x: auto;
    background: var(--cor-superficie);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--texto-sm);
  }

  th,
  td {
    padding: var(--espaco-3) var(--espaco-4);
    text-align: left;
    border-bottom: 1px solid var(--cor-borda);
    white-space: nowrap;
  }

  thead th {
    background: var(--cor-marca-forte);
    color: var(--cor-sobre-marca);
    font-family: var(--fonte-titulo);
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  tbody th {
    white-space: normal;
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .nota {
    margin-top: var(--espaco-4);
  }
</style>
