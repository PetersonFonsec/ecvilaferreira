---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/ui/Hero.astro';
import Section from '@/components/ui/Section.astro';
import DirectorCard from '@/components/cards/DirectorCard.astro';
import { getDiretoria } from '@/lib/content';

const diretoria = await getDiretoria();
---

<BaseLayout titulo="Diretoria" descricao="Conheça a diretoria do Esporte Clube Vila Ferreira.">
  <Hero ilustracao="apito" chapeu="Clube" titulo="Diretoria" texto="Gente do bairro que dedica seu tempo para manter o clube vivo." />

  <Section>
    <ul class="grade grade--estreita" role="list" data-revelar="grupo">
      {
        diretoria.map((membro) => (
          <li>
            <DirectorCard membro={membro} />
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
